#!/usr/bin/env python3

import argparse
import json
import os
import socket
import subprocess
import sys
import tempfile
import time

VERSION = 1
CACHE_FILE = "/var/cache/librenms/proxmox-vminfo.json"
CACHE_MAX_AGE = 1800
PVESH = os.environ.get("PVESH", "/usr/bin/pvesh")
TIMEOUT = 30


class PveError(Exception):
    pass


def pvesh(path, *arguments):
    command = [PVESH, "get", path, *arguments, "--output-format", "json"]

    try:
        result = subprocess.run(
            command, capture_output=True, text=True, timeout=TIMEOUT, check=False
        )
    except OSError as error:
        raise PveError(f"could not run {PVESH}: {error}") from error
    except subprocess.TimeoutExpired as error:
        raise PveError(f"{path} timed out after {TIMEOUT} seconds") from error

    if result.returncode != 0:
        raise PveError(f"{path} failed: {result.stderr.strip()}")

    try:
        return json.loads(result.stdout)
    except ValueError as error:
        raise PveError(f"{path} returned invalid json: {error}") from error


def guests(args):
    node = socket.gethostname().split(".")[0]
    vms = []

    for guest in pvesh("/cluster/resources", "--type", "vm"):
        if guest.get("type") not in ("qemu", "lxc"):
            continue
        if guest.get("node") != node and not args.all_nodes:
            continue
        if guest.get("template") and not args.templates:
            continue

        vm = {
            "vmid": guest.get("vmid"),
            "name": guest.get("name") or f"VM {guest.get('vmid')}",
            "type": guest.get("type"),
            "status": guest.get("status", "unknown"),
            "cpus": int(guest.get("maxcpu") or 0),
            "mem": int(guest.get("maxmem") or 0),
            "node": guest.get("node"),
        }

        vms.append(vm)

    return {"node": node, "vms": vms}


def output(data=None, error_string=""):
    return {
        "version": VERSION,
        "error": 1 if error_string else 0,
        "errorString": error_string,
        "data": data or {"node": "", "vms": []},
    }


def write_cache(payload):
    directory = os.path.dirname(CACHE_FILE)
    os.makedirs(directory, exist_ok=True)
    handle, temporary = tempfile.mkstemp(dir=directory)

    with os.fdopen(handle, "w") as cache:
        json.dump(payload, cache)

    os.chmod(temporary, 0o644)
    os.replace(temporary, CACHE_FILE)


def read_cache():
    age = int(time.time() - os.path.getmtime(CACHE_FILE))

    with open(CACHE_FILE, encoding="utf-8") as cache:
        payload = json.load(cache)

    if age > CACHE_MAX_AGE:
        return output(payload["data"], f"cache is {age} seconds old, is cron running?")

    return payload


def parse_args():
    parser = argparse.ArgumentParser()
    parser.add_argument("--cache", action="store_true", help="write the cache file")
    parser.add_argument("--collect", action="store_true", help="ignore the cache file")
    parser.add_argument("--all-nodes", action="store_true", help="report every node")
    parser.add_argument("--templates", action="store_true", help="include templates")

    return parser.parse_args()


def main():
    args = parse_args()

    try:
        if args.cache:
            write_cache(output(guests(args)))

            return 0

        if args.collect or not os.path.exists(CACHE_FILE):
            payload = output(guests(args))
        else:
            payload = read_cache()
    except (PveError, OSError, ValueError) as error:
        payload = output(None, str(error))

    print(json.dumps(payload))

    return 0


if __name__ == "__main__":
    sys.exit(main())
